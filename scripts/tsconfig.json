{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "resolveJsonModule": true
  },
  "include": ["*.ts", "intake/**/*.ts", "quality/**/*.ts", "downloads/**/*.ts", "listings/**/*.ts", "telemetry/**/*.ts", "announce/**/*.ts", "dev/**/*.ts", "ops/**/*.ts", "lib/**/*.ts", "tests/**/*.ts"],
  "exclude": ["dist"]
}
