{
  "name": "@the-railyard/scripts",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "make-announcement": "tsx announce/make-announcement.ts --filename",
    "test": "pnpm run test:build && pnpm run test:run",
    "test:build": "tsc -p tsconfig.test.json",
    "test:run": "node --test .test-dist/tests/*.test.js",
    "test:security-rules": "pnpm run test:build && node --test --test-isolation=none .test-dist/tests/security-rules-fixtures.test.js",
    "validate-data-quality": "tsx quality/validate-data-quality.ts",
    "validate-publish": "tsx intake/validate-publish.ts",
    "validate-update": "tsx intake/validate-update.ts",
    "validate-author-update": "tsx intake/validate-author-update.ts",
    "create-listing": "tsx intake/create-listing.ts",
    "update-listing": "tsx intake/update-listing.ts",
    "update-author": "tsx intake/update-author.ts",
    "apply-data-quality": "tsx quality/apply-data-quality.ts",
    "check-data-quality": "tsx quality/check-data-quality.ts",
    "format-manifests": "tsx listings/format-manifests.ts",
    "regenerate-indexes": "tsx listings/regenerate-indexes.ts",
    "generate-registry-analytics": "pnpm run generate-registry-analytics:maps && pnpm run generate-registry-analytics:mods",
    "generate-registry-analytics:maps": "tsx downloads/generate-downloads.ts --type map --mode full",
    "generate-registry-analytics:mods": "tsx downloads/generate-downloads.ts --type mod --mode full",
    "generate-registry-demand-stats": "tsx listings/generate-map-demand-stats.ts",
    "generate-downloads": "pnpm run generate-registry-analytics",
    "generate-downloads:maps": "pnpm run generate-registry-analytics:maps",
    "generate-downloads:mods": "pnpm run generate-registry-analytics:mods",
    "generate-downloads:maps:download-only": "tsx downloads/generate-downloads.ts --type map --mode download-only",
    "generate-downloads:mods:download-only": "tsx downloads/generate-downloads.ts --type mod --mode download-only",
    "generate-download-history": "tsx downloads/generate-download-history.ts",
    "audit-download-history": "tsx ops/audit-download-history.ts",
    "audit-shared-map-attribution": "tsx ops/audit-shared-map-attribution.ts",
    "rebuild-download-history-from-git": "tsx ops/rebuild-download-history-from-git.ts",
    "merge-download-attribution": "tsx downloads/merge-download-attribution.ts",
    "backfill-download-attribution": "tsx ops/backfill-download-attribution.ts",
    "spotcheck-attribution-logs": "tsx ops/spotcheck-attribution-logs.ts",
    "create-manual-download-attribution": "tsx ops/create-manual-download-attribution.ts",
    "rebuild-download-version-buckets": "tsx ops/rebuild-download-version-buckets.ts",
    "reconcile-attributed-downloads": "tsx downloads/reconcile-attributed-downloads.ts",
    "analytics": "tsx downloads/generate-analytics.ts",
    "capture-railyard-app-downloads": "tsx telemetry/capture-railyard-app-downloads.ts",
    "capture-website-analytics": "tsx telemetry/capture-website-analytics.ts",
    "backfill-website-analytics": "tsx ops/backfill-website-analytics.ts --days 7",
    "generate-website-analytics": "tsx telemetry/generate-website-analytics.ts",
    "backfill-discord-server-metrics": "tsx telemetry/capture-discord-server-metrics.ts --reset-history",
    "capture-discord-server-metrics": "tsx telemetry/capture-discord-server-metrics.ts",
    "generate-railyard-app-analytics": "tsx telemetry/generate-railyard-app-analytics.ts",
    "generate-discord-server-analytics": "tsx telemetry/generate-discord-server-analytics.ts",
    "generate-map-demand-stats": "pnpm run generate-registry-demand-stats",
    "generate-map-basemaps": "tsx listings/generate-map-basemaps.ts",
    "generate-map-basemaps:check": "tsx listings/generate-map-basemaps.ts --check",
    "generate-map-basemaps:backfill": "tsx listings/generate-map-basemaps.ts",
    "generate-map-basemaps:force": "tsx listings/generate-map-basemaps.ts --force",
    "generate-map-basemaps:populate-completeness": "tsx listings/generate-map-basemaps.ts --populate-completeness-only",
    "record-content-announcements": "tsx announce/record-content-announcements.ts",
    "send-pending-announcements": "tsx announce/send-pending-announcements.ts",
    "generate-local-grid-statistics": "tsx dev/generate-local-grid-statistics.ts",
    "generate-local-playable-area-debug": "tsx dev/generate-local-playable-area-debug.ts",
    "generate-search-aliases": "tsx listings/generate-search-aliases.ts",
    "sync-map-file-sizes": "tsx listings/sync-map-file-sizes.ts",
    "sync-last-updated": "tsx listings/sync-last-updated.ts",
    "notify-discord": "tsx announce/notify-discord.ts",
    "generate-map-templates": "tsx intake/generate-map-templates.ts",
    "check-map-templates": "tsx intake/generate-map-templates.ts --check",
    "generate:map-templates": "tsx intake/generate-map-templates.ts",
    "check:map-templates": "tsx intake/generate-map-templates.ts --check"
  },
  "dependencies": {
    "@babel/parser": "^7.29.2",
    "@babel/traverse": "^7.29.0",
    "@subway-builder-modded/registry-schemas": "workspace:*",
    "@turf/turf": "^7.3.4",
    "@types/geojson": "^7946.0.16",
    "jszip": "^3.10.1",
    "semver": "^7.7.4",
    "sharp": "^0.35.2",
    "yaml": "^2.8.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^22.0.0",
    "@types/semver": "^7.7.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
