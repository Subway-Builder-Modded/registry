{
  "$ref": "#/definitions/mod-manifest",
  "definitions": {
    "mod-manifest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "number",
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "github_id": {
          "type": "integer",
          "minimum": 1
        },
        "collaborators": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "caretakers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "github_id": {
                "type": "integer",
                "minimum": 1
              },
              "since": {
                "type": "string",
                "format": "date-time"
              },
              "until": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "github_id",
              "since"
            ],
            "additionalProperties": false
          }
        },
        "deprecation": {
          "type": "object",
          "properties": {
            "since": {
              "type": "string",
              "format": "date-time"
            },
            "by_github_id": {
              "type": "integer",
              "minimum": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "since",
            "by_github_id"
          ],
          "additionalProperties": false
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "gallery": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "is_test": {
          "type": "boolean"
        },
        "source": {
          "type": "string",
          "format": "uri"
        },
        "update": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "github"
                },
                "repo": {
                  "type": "string",
                  "pattern": "^[^/]+\\/[^/]+$"
                }
              },
              "required": [
                "type",
                "repo"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "custom"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              },
              "required": [
                "type",
                "url"
              ],
              "additionalProperties": false
            }
          ]
        },
        "last_updated": {
          "type": "integer",
          "minimum": 0
        },
        "search_aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "schema_version",
        "id",
        "name",
        "author",
        "github_id",
        "description",
        "tags",
        "gallery",
        "is_test",
        "source",
        "update"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
